# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# cPanel "Setup Node.js App" (Phusion Passenger / LiteSpeed lsnode) — files
# it generates directly in the Application root at runtime. Only relevant
# when the Application root is the same directory as the Git checkout;
# harmless to ignore otherwise.
/.htaccess
/tmp/
/stderr.log
/stdout.log
