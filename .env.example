# Copy this file to .env and fill in your own values.
DATABASE_URL="mysql://user:password@localhost:3306/gotka_crm"

# Required — signs login session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=""

# Optional — enables the AI Assistant (insights, follow-up drafts, pipeline
# diagnosis, business card scanning). Get a key at https://openrouter.ai/keys.
# The app runs fine without it; AI buttons will just show a "not configured"
# message.
OPENROUTER_API_KEY=""

# Optional — which model OpenRouter routes to (see https://openrouter.ai/models
# for the full list). Defaults to openai/gpt-4o-mini, which is cheap, fast,
# and supports both the structured JSON output and the image input the
# business-card scanner needs.
OPENROUTER_MODEL=""

# Optional — your CRM's public URL (no trailing slash), e.g.
# "https://crm.yourcompany.com". Used by two cron scripts that have no
# incoming request to infer their own host from: the daily WhatsApp task
# reminder (to link back to each user's task list) and newsletter sending
# (to build each recipient's unsubscribe link). Both skip sending — rather
# than sending without a working link — until this is set.
SITE_URL=""

# Optional — enables "Continue with Google" on the business directory's
# partner signup page (/directory/signup), and the CRM's own "Connect
# Google Calendar" (Settings → Google Calendar, syncs a staff member's
# assigned Tasks onto their calendar). Create an OAuth 2.0 Client ID (Web
# application) at https://console.cloud.google.com/apis/credentials with
# both "<SITE_URL>/api/auth/google/callback" and
# "<SITE_URL>/api/auth/google-calendar/callback" as authorized redirect
# URIs, and enable the Google Calendar API for the project (APIs & Services
# → Library) — the sign-in flow doesn't need it, but the calendar one will
# fail without it. Each feature just hides its own button when these are
# unset.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional — enables "Your business on Google Maps" search in a partner's
# listing editor (the AI Auto Business Details Creation section). A Google
# Maps Platform API key with "Places API (New)" enabled, created at
# https://console.cloud.google.com/google/maps-apis/credentials — restrict
# it to that one API. Searching (live as a partner types) and each AI Auto
# Create are billed Places requests. Without it, AI Auto Create still works
# from the listing's Website field alone.
#
# Under "Key restrictions" > "Application restrictions", pick IP addresses
# (your server's outbound IP) or None — never Websites. These calls are all
# made from this app's own server, not a browser, so they carry no Referer
# header at all; a Websites (HTTP referrer) restriction rejects every one of
# them with a "referer <empty>" error.
GOOGLE_PLACES_API_KEY=""

# Optional — enables auto-deploy: a push to DEPLOY_BRANCH on GitHub pulls,
# installs, migrates, and restarts this app on its own. See the README's
# "Auto-deploy from GitHub" section for the webhook setup this pairs with.
# Both must be set together, or neither — the app just won't auto-deploy
# without them.
DEPLOY_WEBHOOK_SECRET=""
DEPLOY_BRANCH=""

# Optional — the public business directory's search and AI-search discovery
# plumbing. Each one is independent, and its feature just stays off while
# it's unset. Ownership tokens from Google Search Console and Bing Webmaster
# Tools: add the site with each console's "HTML tag" method and copy the
# content="..." value here (they render as <meta> tags on the directory
# pages only).
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
# IndexNow key — 8-128 letters, digits or hyphens (`openssl rand -hex 16`).
# With it set, publishing, unpublishing or moving a listing pings Bing (and
# through it Copilot and ChatGPT search), Yandex, Naver and Seznam at once
# rather than waiting for their next crawl; the key is served back at
# /indexnow-key.txt to prove ownership. Google doesn't take part.
INDEXNOW_KEY=""
# Plausible Analytics on the directory pages only (never the CRM or the
# portals): the site as registered in Plausible, and the script URL of a
# self-hosted instance (leave empty for plausible.io's).
PLAUSIBLE_DOMAIN=""
PLAUSIBLE_SCRIPT_URL=""

# Optional — the public origin (no trailing slash) the auto-deploy's
# post-deploy smoke test should check, e.g. "https://crm.yourcompany.com";
# falls back to SITE_URL. With neither set the deploy skips the smoke test.
DEPLOY_SMOKE_URL=""
