# Copy this file to .env and fill in your own values.
DATABASE_URL="mysql://user:password@localhost:3306/gotech_crm"

# Required — signs login session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=""

# Optional — enables the AI Assistant (insights, follow-up drafts, pipeline
# diagnosis, business card scanning). Get a key at https://openrouter.ai/keys.
# The app runs fine without it; AI buttons will just show a "not configured"
# message.
OPENROUTER_API_KEY=""

# Optional — which model OpenRouter routes to (see https://openrouter.ai/models
# for the full list). Defaults to openai/gpt-4o-mini, which is cheap, fast,
# and supports both the structured JSON output and the image input the
# business-card scanner needs.
OPENROUTER_MODEL=""

# Optional — your CRM's public URL (no trailing slash), e.g.
# "https://crm.yourcompany.com". Only used by the daily WhatsApp task
# reminder script to link back to each user's own task list; that reminder
# sends nothing without it.
SITE_URL=""
