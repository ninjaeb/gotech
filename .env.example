# Copy this file to .env and fill in your own values.
DATABASE_URL="mysql://user:password@localhost:3306/gotech_crm"

# Optional — enables the AI Assistant (insights, follow-up drafts, pipeline
# diagnosis). Get a key at https://console.anthropic.com. The app runs fine
# without it; AI buttons will just show a "not configured" message.
ANTHROPIC_API_KEY=""
