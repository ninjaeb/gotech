// Prisma schema for the Gotka CRM
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum TaskType {
  CALL
  EMAIL
  MEETING
  FOLLOW_UP
  MILESTONE
  OTHER
}

// Declared low-to-high so `orderBy: { priority: "desc" }` sorts HIGH first
// (MySQL enums sort by declaration ordinal).
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  WHATSAPP
  MEETING
  STAGE_CHANGE
  TASK_COMPLETED
}

// PARTNER is an external referrer, not staff: they only ever see the
// partner portal (/partner — their referral link, the leads it brought in,
// and their commissions), never the CRM itself. See src/lib/referrals.ts.
enum Role {
  ADMIN
  TECHNICAL
  SALES
  PARTNER
}

// Meta's per-message delivery lifecycle, reported via the webhook's
// `statuses` events (see src/app/api/whatsapp/webhook/route.ts) and matched
// back to the Activity that logged the send via externalId "whatsapp:<wamid>".
// Only ever set on outbound WhatsApp activities — inbound messages and every
// other ActivityType have no delivery lifecycle to track.
enum WhatsAppMessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum WhatsAppMediaType {
  IMAGE
  DOCUMENT
  VIDEO
}

enum LeadSource {
  WEBSITE
  REFERRAL
  COLD_CALL
  SOCIAL_MEDIA
  ADVERTISEMENT
  EVENT
  PARTNER
  OTHER
}

enum LifecycleStage {
  SUBSCRIBER
  LEAD
  MQL
  SQL
  OPPORTUNITY
  CUSTOMER
  EVANGELIST
  OTHER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  title        String?
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())

  // Billing rate for cost-tracking on projects (cost = logged hours × this
  // rate). Optional — projects with unrated contributors just report those
  // hours as unrated instead of guessing a cost.
  hourlyRate Decimal? @db.Decimal(10, 2)

  // Set by an admin from Settings → Team — this user's opt-in number for
  // two internal WhatsApp notifications: the daily task reminder (see
  // scripts/send-task-digests-whatsapp.ts) and being @mentioned (see
  // notifyMentionsViaWhatsApp in src/lib/whatsapp.ts). Not used for
  // anything else; the WhatsApp *Business* number staff message clients
  // from is a separate, shared WhatsAppAccount, unrelated to this.
  phone                        String?
  lastTaskDigestWhatsAppSentAt DateTime?

  // Two more opt-in WhatsApp pings, kept as their own booleans rather than
  // folded into the phone-presence gate above: the four notifications above
  // are each about something specifically involving this one user (you were
  // mentioned, assigned, etc.), while a new inbound WhatsApp message or a
  // new lead has no single "assignee" to narrow the ping to — every admin
  // could plausibly want one, and, for a busy shared inbox especially, just
  // as plausibly not. Set by an admin from Settings → Team, same as phone;
  // both no-op without a phone number set too.
  notifyNewWhatsAppMessage Boolean @default(false)
  notifyNewLead            Boolean @default(false)

  // JSON: { [pageType]: { main: string[], sidebar: string[] } } — which
  // sections this user has dragged where on the Deal/Company/Contact detail
  // pages. A personal display preference, so it lives on User rather than
  // on the entities being viewed.
  sectionLayout String? @db.Text

  // Referral program — both only meaningful for role PARTNER (see
  // src/lib/referrals.ts). referralCode is the slug in that partner's
  // share link (/r/<code>), generated once when the account becomes a
  // partner and never changed, since it's already out in the wild on
  // whatever they've shared. referralCommissionRate (a percent) overrides
  // Settings.referralCommissionRate for this one partner; null means "use
  // the default".
  referralCode           String?  @unique
  referralCommissionRate Decimal? @db.Decimal(5, 2)

  emailAccount                           EmailAccount?
  deals                                  Deal[]
  referredDeals                          Deal[]                              @relation("DealReferredBy")
  referralClicks                         ReferralClick[]
  referralCommissions                    ReferralCommission[]
  referralWithdrawals                    ReferralWithdrawal[]
  timeEntries                            TimeEntry[]
  sequenceEnrollments                    SequenceEnrollment[]
  assignedTasks                          TaskAssignee[]
  followingTasks                         TaskFollower[]
  notifications                          Notification[]
  contactLists                           ContactList[]
  sentMentionNotifications               WhatsAppMentionNotification[]       @relation("MentionNotificationForwardTo")
  receivedMentionNotifications           WhatsAppMentionNotification[]       @relation("MentionNotificationRecipient")
  pendingAssignmentNotifications         PendingTaskAssignmentNotification[] @relation("PendingAssignmentRecipient")
  assignedPendingAssignmentNotifications PendingTaskAssignmentNotification[] @relation("PendingAssignmentAssigner")
  newsletters                            Newsletter[]
  whatsAppBroadcasts                     WhatsAppBroadcast[]
  partnerListing                         PartnerListing?
  directoryLeadReplies                   DirectoryLeadReply[]
}

// One connected IMAP/SMTP mailbox per user (their own inbox, not a shared
// team one) — see src/lib/email-sync.ts. Credentials are never stored in
// plaintext.
model EmailAccount {
  id                String  @id @default(cuid())
  email             String
  imapHost          String
  imapPort          Int     @default(993)
  imapSecure        Boolean @default(true)
  smtpHost          String
  smtpPort          Int     @default(465)
  smtpSecure        Boolean @default(true)
  username          String
  // AES-256-GCM ciphertext ("iv:authTag:ciphertext", base64) — the key is
  // derived from SESSION_SECRET via HKDF (see src/lib/email-crypto.ts), so
  // connecting a mailbox needs no extra required env var to deploy.
  encryptedPassword String  @db.Text

  // Both purely cosmetic, editable independently of the credentials above
  // (see updateEmailSenderSettings) — no reconnect needed to change either.
  // fromName, when set, becomes the display name on the From header
  // ("Jane Doe" <jane@gotka.com>) instead of a bare address; htmlSignature
  // is raw HTML appended below the body of every email this account sends
  // (see sendEmailViaAccount) whenever it's non-empty.
  fromName      String?
  htmlSignature String? @db.Text

  // JSON: { [folderPath]: highestUidSeen } — an IMAP UID only ever increases
  // within a folder, so "highest UID synced" is a cheap, correct incremental
  // checkpoint per folder (INBOX and the account's Sent folder are tracked
  // separately, since their UID sequences are independent).
  syncState        String    @default("{}") @db.Text
  lastSyncedAt     DateTime?
  lastSyncError    String?   @db.Text
  // Rate-limits runEmailTaskDigests (src/lib/task-digest.ts) to roughly once
  // a day regardless of how often its cron job (scripts/sync-email.ts)
  // actually runs.
  lastDigestSentAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique
}

// Single-row table for the org's WhatsApp Business connection — one shared
// Business phone number for the whole team, unlike EmailAccount (one row
// per user's own mailbox). Always read/written at id "singleton" — see
// src/lib/whatsapp.ts. Credentials come from the Meta WhatsApp Business
// Platform (Cloud API): https://developers.facebook.com/docs/whatsapp/cloud-api
model WhatsAppAccount {
  id                 String  @id @default("singleton")
  phoneNumberId      String
  businessAccountId  String
  displayPhoneNumber String?

  // Both AES-256-GCM ciphertext ("iv:authTag:ciphertext", base64) via
  // src/lib/email-crypto.ts (a generically-named "encrypt a secret at rest"
  // helper despite the filename, already used for EmailAccount passwords).
  encryptedAccessToken String @db.Text
  encryptedAppSecret   String @db.Text

  // Arbitrary token we generate and Meta echoes back during the webhook
  // verification handshake (GET request) — proves the callback URL is ours,
  // not a credential in itself, so it's fine to store in the clear.
  webhookVerifyToken String

  lastSyncError String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Single-row table for CRM-wide settings (currency, booking-link
// availability). Always read/written at id "singleton" — see src/lib/settings.ts.
model Settings {
  id       String @id @default("singleton")
  currency String @default("USD")

  // Booking link (see src/lib/booking.ts). A fixed UTC offset rather than an
  // IANA timezone — simpler and DST-free, and the org this ships for doesn't
  // observe DST — labeled clearly in the Settings UI rather than pretending
  // to be a full tz database. Also doubles as the org's timezone for
  // taskReminderHour below, rather than adding a second offset setting for
  // the same one org.
  bookingUtcOffsetMinutes Int    @default(480) // UTC+8
  bookingSlotMinutes      Int    @default(30)
  // JSON-encoded WeeklyHours (see src/lib/booking.ts) — 7 entries,
  // index 0 = Sunday..6 = Saturday, each { enabled, start: "HH:mm", end: "HH:mm" }.
  bookingWeeklyHours      String @default("[{\"enabled\":false,\"start\":\"09:00\",\"end\":\"17:00\"},{\"enabled\":true,\"start\":\"09:00\",\"end\":\"17:00\"},{\"enabled\":true,\"start\":\"09:00\",\"end\":\"17:00\"},{\"enabled\":true,\"start\":\"09:00\",\"end\":\"17:00\"},{\"enabled\":true,\"start\":\"09:00\",\"end\":\"17:00\"},{\"enabled\":true,\"start\":\"09:00\",\"end\":\"17:00\"},{\"enabled\":false,\"start\":\"09:00\",\"end\":\"17:00\"}]") @db.Text

  // Local hour of day (0-23, in bookingUtcOffsetMinutes' timezone) the daily
  // WhatsApp task reminder should send at — see
  // scripts/send-task-digests-whatsapp.ts, which is meant to run hourly via
  // cron and only actually sends during the hour that matches this.
  taskReminderHour Int @default(8) // 8am

  // Minutes to hold a task assignment notification before actually sending
  // it (in-app + WhatsApp) — 0 sends immediately. Lets an assigner tell
  // someone in person/Slack first without a duplicate CRM ping, or simply
  // avoid interrupting them right away. Applied via
  // PendingTaskAssignmentNotification below, drained by the same cron job
  // as the daily digests (see scripts/sync-email.ts) rather than a timer,
  // since nothing in this app assumes the process stays running.
  taskAssignmentNotificationDelayMinutes Int @default(0)

  // Which ContactList a submission to the public newsletter subscribe form
  // (src/app/api/public/newsletter-subscribe/route.ts, and the hosted
  // /subscribe page) adds new contacts to — set from Settings → Newsletter.
  // Null means the form isn't wired up to anything yet; both submission
  // paths refuse to do anything until an admin picks one. Deliberately a
  // STATIC list, not a DYNAMIC (filter-based) one — a subscribe form adds a
  // real membership row per person, which only a STATIC list stores.
  newsletterSubscribeList   ContactList? @relation(fields: [newsletterSubscribeListId], references: [id], onDelete: SetNull)
  newsletterSubscribeListId String?

  // Referral program defaults (Settings → Referrals). The rate is a percent
  // of a referred deal's value, applied the moment that deal is won unless
  // the partner has their own User.referralCommissionRate. The landing URL
  // is where a partner's /r/<code> link sends visitors — the marketing page
  // that embeds the lead-capture widget, which reads the ?ref= this app
  // appends and passes it back with the submission.
  referralCommissionRate Decimal @default(10) @db.Decimal(5, 2)
  referralLandingUrl     String  @default("https://gotka.com/landing/new-business/")
}

enum Industry {
  TECHNOLOGY
  RETAIL_ECOMMERCE
  HEALTHCARE
  FINANCE_BANKING
  MANUFACTURING
  CONSTRUCTION_REAL_ESTATE
  EDUCATION
  HOSPITALITY_TOURISM
  PROFESSIONAL_SERVICES
  MEDIA_ENTERTAINMENT
  TRANSPORTATION_LOGISTICS
  AGRICULTURE
  ENERGY_UTILITIES
  GOVERNMENT_NONPROFIT
  TELECOMMUNICATIONS
  AUTOMOTIVE
  FOOD_BEVERAGE
  LEGAL
  MARKETING_ADVERTISING
  OTHER
}

model Company {
  id        String    @id @default(cuid())
  name      String
  domain    String?
  // Curated category, not free text — see Industry above and
  // INDUSTRY_LABELS in src/lib/labels.ts. Null means unclassified rather
  // than guessing, same as Contact.lifecycleStage and Deal.source.
  industry  Industry?
  phone     String?
  address   String?
  notes     String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  contacts             Contact[]
  deals                Deal[]
  tasks                Task[]
  activities           Activity[]
  resources            CompanyResource[]
  mentionNotifications WhatsAppMentionNotification[]

  @@index([name])
}

model CompanyResource {
  id        String   @id @default(cuid())
  title     String
  url       String   @db.Text
  createdAt DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  @@index([companyId])
}

model Contact {
  id        String   @id @default(cuid())
  firstName String
  lastName  String?
  email     String?
  phone     String?
  title     String?
  notes     String?  @db.Text
  // Stored as a data: URL (base64), not a file path — this app's cPanel
  // deploy copies public/ on every deploy and the git checkout can double
  // as the live app directory, both of which make filesystem-persisted
  // uploads fragile. Keeping the photo in the same row as everything else
  // sidesteps that entirely. @db.LongText because a base64-encoded image
  // comfortably exceeds the default column's size.
  photoUrl  String?  @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Null (not a default like SUBSCRIBER) means genuinely unclassified —
  // most existing contacts predate this field. Auto-set to LEAD by the
  // public /lead form and to CUSTOMER when a linked Deal is won (see
  // src/app/actions/leads.ts and src/app/actions/deals.ts); otherwise
  // editable by hand from the contact detail page.
  lifecycleStage LifecycleStage?

  // Last time email sync saw an inbound message from this contact — not
  // shown anywhere yet, but it's what lets an outbound sequence
  // (src/lib/sequences.ts) auto-stop the moment a contact replies, by
  // comparing this against the enrollment's enrolledAt rather than
  // re-scanning Activity rows.
  lastInboundEmailAt DateTime?

  // A single team-wide read marker for this contact's WhatsApp thread, not
  // per-user — matches the WhatsApp Business number itself being shared
  // across the whole team rather than owned by one person the way email is.
  // Set by markWhatsAppThreadRead whenever anyone opens the thread; a
  // conversation counts as unread when its latest inbound message postdates
  // this (see isWhatsAppConversationUnread in src/lib/whatsapp.ts).
  whatsappLastReadAt DateTime?

  // Set by the public one-click unsubscribe link every newsletter send
  // includes (see src/app/unsubscribe/[token]/page.tsx) — never set any
  // other way, and nothing in the UI clears it automatically, so re-opting
  // in is a deliberate admin action. Checked when a Newsletter's recipients
  // are materialized (src/lib/newsletters.ts); has no effect on 1:1 email
  // or sequences, which aren't bulk/marketing send and aren't what this
  // flag is about.
  emailOptOut   Boolean   @default(false)
  emailOptOutAt DateTime?

  // Explicit marketing consent for the WhatsApp channel — captured by the
  // public newsletter subscribe form's channel choice (see
  // src/lib/newsletter-subscribe.ts), independent of emailOptOut above
  // since a contact can opt into either channel on its own. Distinct from
  // whatsappLastReadAt (staff conversation state, not consent) and from
  // WhatsAppAccount (the shared business number itself). Cleared by a
  // "STOP"/"UNSUBSCRIBE" reply on that channel (see the inbound webhook,
  // src/app/api/whatsapp/webhook/route.ts) the same way emailOptOut is
  // cleared by the one-click email unsubscribe link.
  whatsappMarketingOptIn   Boolean   @default(false)
  whatsappMarketingOptInAt DateTime?

  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId String?

  deals                       Deal[]
  tasks                       Task[]
  activities                  Activity[]
  bookings                    Booking[]
  clientUser                  ClientUser?
  sequenceEnrollments         SequenceEnrollment[]
  mentionNotifications        WhatsAppMentionNotification[]
  listMemberships             ContactListMember[]
  testimonials                Testimonial[]
  newsletterRecipients        NewsletterRecipient[]
  whatsAppBroadcastRecipients WhatsAppBroadcastRecipient[]

  @@index([companyId])
  @@index([lastName, firstName])
  @@index([lifecycleStage])
}

enum ListType {
  STATIC
  DYNAMIC
}

// A saved segment of contacts — either a hand-picked set (STATIC, via
// ContactListMember) or a live query re-evaluated on every view (DYNAMIC).
// Dynamic lists don't carry a generic filter DSL: v1 only ships a handful
// of hardcoded templates (see DYNAMIC_LIST_TEMPLATES in
// src/lib/contact-lists.ts), so filterDefinition only ever holds
// `{ template: "<key>" }` today. It's still a real JSON column rather than
// a plain template-key string so a future generic query builder can widen
// what that JSON shape holds without another migration.
model ContactList {
  id   String   @id @default(cuid())
  name String
  type ListType

  filterDefinition Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  members               ContactListMember[]
  newsletters           Newsletter[]
  whatsAppBroadcasts    WhatsAppBroadcast[]
  // Always at most one row (Settings is a singleton) — see
  // Settings.newsletterSubscribeListId above.
  subscribeFormSettings Settings[]

  @@index([ownerId])
}

model ContactListMember {
  id      String   @id @default(cuid())
  addedAt DateTime @default(now())

  list   ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId String

  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String

  @@unique([listId, contactId])
  @@index([contactId])
}

// A client-side portal login, entirely separate from the internal User
// model/session (see src/lib/portal/session.ts — a distinct signed cookie,
// distinct signing key). Scoped through its Contact to that Contact's
// Company, never directly to a companyId, so portal access can never
// outlive or outgrow the underlying CRM relationship. passwordHash is null
// until the invite (inviteToken) is accepted.
model ClientUser {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String?   @db.Text
  inviteToken          String?   @unique
  inviteTokenExpiresAt DateTime?
  createdAt            DateTime  @default(now())

  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String  @unique
}

// A confirmed slot from the public booking page (see src/app/book). The
// unique startAt is the actual double-booking guard — two people can't
// reserve the same fixed-duration slot even under a concurrent submit race
// (the DB rejects the second insert; see submitBooking's error handling).
model Booking {
  id        String   @id @default(cuid())
  startAt   DateTime
  endAt     DateTime
  name      String
  email     String
  phone     String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String

  @@unique([startAt])
  @@index([contactId])
}

// A deal type's own ordered stage list (Zoho-style "Blueprint"), so a
// new-build project, a maintenance retainer, and a referral don't have to
// share one kanban. Every install gets exactly one pipeline seeded with
// today's original 6 stages (see the add_pipelines migration) — additional
// pipelines are opt-in, created from Settings.
model Pipeline {
  id        String   @id @default(cuid())
  name      String
  isDefault Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  stages PipelineStage[]
  deals  Deal[]

  @@index([sortOrder])
}

// isWon/isLost replace the old fixed WON/LOST enum values — every stage-gate,
// rotting, and project-handoff check that used to compare against those
// strings now checks these flags instead, so each pipeline can name its own
// terminal stages ("Closed Won", "Signed", ...) while that logic stays
// pipeline-agnostic. Exactly one stage in a pipeline should carry each flag,
// enforced by the pipeline editor rather than the schema.
model PipelineStage {
  id        String  @id @default(cuid())
  name      String
  sortOrder Int
  isWon     Boolean @default(false)
  isLost    Boolean @default(false)

  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  pipelineId String

  deals Deal[]

  @@index([pipelineId])
}

model Deal {
  id                String      @id @default(cuid())
  title             String
  value             Decimal     @default(0) @db.Decimal(12, 2)
  expectedCloseDate DateTime?
  notes             String?     @db.Text
  // Nullable rather than defaulted — an unset source is a genuinely
  // different fact than "Other", and every deal that predates this field
  // has no honest value to backfill. The public lead form (src/app/actions/
  // leads.ts) sets WEBSITE automatically; anything else is picked by hand.
  source            LeadSource?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Set/cleared automatically whenever the deal moves into/out of a
  // pipeline's isWon stage (see app/actions/deals.ts) — not just "is this
  // deal currently won" (pipelineStage.isWon already answers that) but
  // *when* it most recently became won, for period-filtering the
  // leaderboard (see src/app/(app)/leaderboard).
  wonAt DateTime?

  pipeline   Pipeline @relation(fields: [pipelineId], references: [id])
  pipelineId String

  pipelineStage   PipelineStage @relation(fields: [pipelineStageId], references: [id])
  pipelineStageId String

  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId String?

  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId String?

  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId String?

  // The PARTNER whose referral link this lead came in through (see
  // src/lib/referrals.ts) — set once by the public lead form when its
  // submission carried a valid ?ref= code, never by hand. Drives the
  // partner portal's lead list and the commission awarded on win.
  referredBy   User?   @relation("DealReferredBy", fields: [referredById], references: [id], onDelete: SetNull)
  referredById String?

  tasks                Task[]
  activities           Activity[]
  quotes               Quote[]
  resources            DealResource[]
  project              Project?
  mentionNotifications WhatsAppMentionNotification[]
  referralCommission   ReferralCommission?

  @@index([companyId])
  @@index([contactId])
  @@index([pipelineId])
  @@index([pipelineStageId])
  @@index([ownerId])
  @@index([referredById])
}

// An external link related to a deal — a proposal doc, a presentation deck,
// a shared folder, anything else worth keeping one click away. Deliberately
// just a label + URL rather than a fixed set of resource types: "proposal"
// and "presentation slide" are common cases, not an exhaustive list.
model DealResource {
  id        String   @id @default(cuid())
  title     String
  url       String   @db.Text
  createdAt DateTime @default(now())

  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId String

  @@index([dealId])
}

// The delivery-side counterpart to a won Deal — spun up automatically (see
// ensureProjectForWonDeal) instead of dumping delivery work into the same
// flat task list as sales to-dos. One deal converts into at most one
// project, hence the unique dealId; the project's own status then tracks
// delivery progress independently of the deal's (now-frozen) sales stage.
model Project {
  id        String        @id @default(cuid())
  name      String
  status    ProjectStatus @default(NOT_STARTED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Internal targets for the budget/timeline tracking on the project page —
  // set once (typically at kickoff), compared against actuals computed from
  // TimeEntry (hours, and cost via each logger's User.hourlyRate).
  budgetHours          Int?
  budgetAmount         Decimal?  @db.Decimal(12, 2)
  targetCompletionDate DateTime?

  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId String @unique

  tasks                Task[]
  activities           Activity[]
  invoices             Invoice[]
  mentionNotifications WhatsAppMentionNotification[]
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?      @db.Text
  type        TaskType     @default(OTHER)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  completed   Boolean      @default(false)
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String?

  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String?

  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId String?

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?

  timeEntries                    TimeEntry[]
  assignees                      TaskAssignee[]
  followers                      TaskFollower[]
  notifications                  Notification[]
  activities                     Activity[]
  attachments                    Attachment[]
  mentionNotifications           WhatsAppMentionNotification[]
  pendingAssignmentNotifications PendingTaskAssignmentNotification[]

  @@index([contactId])
  @@index([companyId])
  @@index([dealId])
  @@index([projectId])
  @@index([dueDate])
}

// Who's responsible for a Task — a task can have more than one assignee, so
// this is a plain many-to-many via an explicit join model (same convention
// as TaskFollower below, which tracks who just wants visibility instead).
model TaskAssignee {
  id String @id @default(cuid())

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([taskId, userId])
  @@index([userId])
}

// Who gets visibility on a Task without being one of the people responsible
// for it (that's `Task.assignees`) — a plain many-to-many via an explicit
// join model, matching this schema's convention of never using Prisma's
// implicit m:n tables.
model TaskFollower {
  id String @id @default(cuid())

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([taskId, userId])
  @@index([userId])
}

// A logged block of work on a Task. Rollup totals on Deal/Project/Contact/
// Company pages aggregate through task.{dealId,projectId,contactId,companyId}
// rather than duplicating a parent link here.
model TimeEntry {
  id        String   @id @default(cuid())
  minutes   Int
  note      String?  @db.Text
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([taskId])
  @@index([userId])
}

model Activity {
  id        String       @id @default(cuid())
  type      ActivityType
  content   String       @db.Text
  createdAt DateTime     @default(now())

  // Set only for activities auto-logged by email sync — a stable dedup key
  // ("<accountId>:<folder>:<uid>:<contactId>", one row per matched contact
  // since a single email can match several) so a re-run over the same IMAP
  // UID range can never double-log the same message. Null for every
  // manually-created activity.
  externalId String? @unique

  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String?

  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String?

  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId String?

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?

  // Set alongside contactId when a note/email/WhatsApp send is logged from
  // a Task's own detail page, so it shows up in that task's activity log
  // as well as the contact's — not a replacement for the other parent
  // fields, since an activity can belong to a task and its contact at once.
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String?

  // Set only on outbound WhatsApp activities (content prefixed "Sent
  // WhatsApp message:"); null for inbound WhatsApp and every other type.
  // See WhatsAppMessageStatus.
  whatsappStatus WhatsAppMessageStatus?

  // Set together, only on a WhatsApp activity that carries an attachment
  // (either direction) — content is then the caption, or a placeholder
  // like "Sent an image" when there wasn't one. whatsappMediaData is
  // base64, same data:-URL-in-the-database approach as Contact.photoUrl
  // (see src/lib/photo.ts) and for the same reason (no durable filesystem
  // to write to on this app's cPanel deploy target) — but served through
  // /api/whatsapp/media/[activityId] rather than embedded inline, so the
  // thread's 2-second poll never has to re-serialize multi-MB bytes.
  whatsappMediaType     WhatsAppMediaType?
  whatsappMediaMimeType String?
  whatsappMediaName     String? // original/suggested filename — mainly for documents
  whatsappMediaData     String?            @db.LongText

  notifications Notification[]
  attachments   Attachment[]

  @@index([contactId])
  @@index([companyId])
  @@index([dealId])
  @@index([projectId])
  @@index([taskId])
  @@index([createdAt])
}

// A file or pasted image attached to an Activity note or a Task's
// description — same data:-URL-in-the-database approach as
// Activity.whatsappMediaData above (no durable filesystem to write to on
// this app's cPanel deploy target), and likewise served through
// /api/attachments/[id] rather than embedded inline, so a page with many
// notes never has to re-serialize every attachment's bytes just to render
// the timeline. Exactly one of activityId/taskId is set per row — same
// "one of several optional parents" convention as Activity itself.
model Attachment {
  id        String   @id @default(cuid())
  fileName  String
  mimeType  String
  size      Int
  data      String   @db.LongText
  createdAt DateTime @default(now())

  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  activityId String?

  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String?

  @@index([activityId])
  @@index([taskId])
}

// An @mention in an Activity note. content is composed once at creation
// time (who mentioned you, on what) rather than re-derived on every read —
// same tradeoff as the task digest email: simpler to render, and stays
// meaningful even if the activity or mentioning user is later edited.
model Notification {
  id        String   @id @default(cuid())
  content   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  activityId String?

  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String?

  @@index([userId, read])
  @@index([activityId])
  @@index([taskId])
}

// One row per WhatsApp @mention notification actually sent (see
// notifyMentionsViaWhatsApp in src/lib/whatsapp.ts). Lets an inbound
// WhatsApp reply that quotes that message — Meta's Cloud API includes the
// quoted message's id as "context.id" on the webhook payload — be matched
// back to who to forward the reply to (mentioner) and which entity to log
// it against. Never deleted once matched: the same sent message can be
// swipe-replied to more than once.
model WhatsAppMentionNotification {
  id    String @id @default(cuid())
  wamid String @unique

  // Whoever this exact WhatsApp message was sent to. If they swipe-reply
  // to it, the reply forwards on to forwardTo below and a new row is
  // created with recipient/forwardTo swapped (see handleMentionReply in
  // the webhook route) — so the exchange keeps forwarding indefinitely in
  // either direction, not just the one round trip this table originally
  // supported. The first hop's recipient is whoever got @mentioned.
  recipient   User   @relation("MentionNotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId String

  // The other party in this exchange — a reply to this message forwards
  // to them. First hop: whoever wrote the @mention. Every hop after:
  // whoever's reply this message itself just forwarded.
  forwardTo   User   @relation("MentionNotificationForwardTo", fields: [forwardToId], references: [id], onDelete: Cascade)
  forwardToId String

  // Quoted back as "You said: ..." if recipient replies — the original
  // @mention text on the first hop, or whichever reply text this message
  // itself just forwarded, on every hop after.
  excerpt String @db.Text

  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String?

  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String?

  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId String?

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?

  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String?

  createdAt DateTime @default(now())

  @@index([contactId])
  @@index([companyId])
  @@index([dealId])
  @@index([projectId])
  @@index([taskId])
}

// A task-assignment notification (in-app + WhatsApp) held until `sendAt`,
// rather than sent immediately — see Settings.taskAssignmentNotificationDelayMinutes
// and notifyTaskAssignment in src/app/actions/tasks.ts. Drained by the same
// cron job as the daily digests (scripts/sync-email.ts), which is why this
// is a DB row rather than an in-process timer: nothing here assumes the
// server stays running between when a task gets assigned and when the
// delay elapses. @@unique on (taskId, userId) means re-assigning someone
// who already has a pending notification for this task just pushes its
// sendAt out (upsert) instead of sending twice.
model PendingTaskAssignmentNotification {
  id String @id @default(cuid())

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String

  // Whoever got assigned — the notification recipient.
  user   User   @relation("PendingAssignmentRecipient", fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Whoever did the assigning — named in the notification text itself, so
  // kept as its own relation (for cascade cleanup) rather than just the
  // denormalized assignerName below.
  assigner   User   @relation("PendingAssignmentAssigner", fields: [assignerId], references: [id], onDelete: Cascade)
  assignerId String

  assignerName String
  taskTitle    String
  sendAt       DateTime
  createdAt    DateTime @default(now())

  @@unique([taskId, userId])
  @@index([sendAt])
}

enum ProductServiceType {
  PRODUCT
  SERVICE
}

// Informational only — this CRM's Invoice model is payment-milestone based
// (see InvoiceStatus below), not a subscription engine, so this doesn't
// drive any automatic recurring billing. It just tells staff how a catalog
// item is meant to be charged when quoting or discussing it with a client.
enum BillingFrequency {
  ONE_TIME
  MONTHLY
  QUARTERLY
  YEARLY
}

// Reusable catalog of things Gotka sells, so quotes are built from
// consistent line items instead of free-typed descriptions/prices every time.
model ServicePackage {
  id               String             @id @default(cuid())
  name             String
  type             ProductServiceType @default(SERVICE)
  description      String?            @db.Text
  unitPrice        Decimal            @default(0) @db.Decimal(12, 2)
  // What it costs Gotka to deliver this, for margin visibility — optional
  // since most catalog items historically never tracked cost; margin is
  // derived from this + unitPrice wherever shown, never stored, so the two
  // can't drift out of sync.
  unitCost         Decimal?           @db.Decimal(12, 2)
  unit             String? // e.g. "project", "hour", "month" — free text, shown after the price
  billingFrequency BillingFrequency   @default(ONE_TIME)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  quoteItems         QuoteItem[]
  quoteTemplateItems QuoteTemplateItem[]

  // A "bundle" is any catalog item that lists other items as components —
  // deliberately one level deep only (a component can't itself have
  // components; enforced in service-packages.ts) so this can't form a
  // cycle. Picking a bundle on a quote expands it into one real line per
  // component instead of a single collapsed line (see QuoteForm) — the
  // bundle's own price/cost below stay independent, shown on the catalog
  // page as a reference rather than force-summed from its parts, so a
  // package can still be priced below (or above) the sum of what's in it.
  components ServicePackageComponent[] @relation("BundleComponents")
  bundledIn  ServicePackageComponent[] @relation("ComponentOf")

  @@index([type])
}

model ServicePackageComponent {
  id        String  @id @default(cuid())
  quantity  Decimal @default(1) @db.Decimal(10, 2)
  sortOrder Int     @default(0)

  bundle   ServicePackage @relation("BundleComponents", fields: [bundleId], references: [id], onDelete: Cascade)
  bundleId String

  product   ServicePackage @relation("ComponentOf", fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@index([bundleId])
  @@index([productId])
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
}

model Quote {
  id     String      @id @default(cuid())
  title  String
  status QuoteStatus @default(DRAFT)
  notes  String?     @db.Text // terms shown to the client under the line items

  sentAt        DateTime?
  firstViewedAt DateTime?
  lastViewedAt  DateTime?
  viewCount     Int       @default(0)
  respondedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId String

  items QuoteItem[]

  @@index([dealId])
}

model QuoteItem {
  id          String  @id @default(cuid())
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @default(0) @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId String

  servicePackage   ServicePackage? @relation(fields: [servicePackageId], references: [id], onDelete: SetNull)
  servicePackageId String?

  @@index([quoteId])
  @@index([servicePackageId])
}

enum TestimonialStatus {
  PENDING
  SUBMITTED
}

// A unique, unauthenticated link (see src/app/testimonial/[token]) sent to a
// client so they can submit a testimonial. aiDraft is a starting point
// generated from the contact's won deals' accepted quote items (see
// buildTestimonialContext in src/lib/ai/context.ts) — theirs to rewrite
// freely; content/rating/author fields stay null until they actually submit.
model Testimonial {
  id     String            @id @default(cuid())
  token  String            @unique
  status TestimonialStatus @default(PENDING)

  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String

  aiDraft String? @db.Text

  content     String? @db.Text
  rating      Int?
  authorName  String?
  authorTitle String?

  createdAt   DateTime  @default(now())
  submittedAt DateTime?

  @@index([contactId])
}

// A saved, reusable line-item bundle — pick one when starting a new Quote
// to seed its items instead of adding each one by hand every time. Deletes
// independently of any Quote built from it: applying a template just
// copies its items in client-side (see QuoteForm), it doesn't link the
// resulting QuoteItems back to this record.
model QuoteTemplate {
  id        String   @id @default(cuid())
  name      String
  notes     String?  @db.Text // default terms, copied into the quote's notes when applied
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items QuoteTemplateItem[]
}

model QuoteTemplateItem {
  id          String  @id @default(cuid())
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @default(0) @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  quoteTemplate   QuoteTemplate @relation(fields: [quoteTemplateId], references: [id], onDelete: Cascade)
  quoteTemplateId String

  servicePackage   ServicePackage? @relation(fields: [servicePackageId], references: [id], onDelete: SetNull)
  servicePackageId String?

  @@index([quoteTemplateId])
  @@index([servicePackageId])
}

// Payment-milestone billing for a Project (post-sale — a Quote is the
// pre-sale document). A project typically carries several Invoices over its
// life (deposit, progress billing, final), each walking its own status
// through these milestones rather than a generic sent/paid pair.
enum InvoiceStatus {
  DRAFT
  DEPOSIT_SENT
  PROGRESS_BILLED
  PAID_IN_FULL
}

model Invoice {
  id      String        @id @default(cuid())
  title   String
  amount  Decimal       @db.Decimal(12, 2)
  status  InvoiceStatus @default(DRAFT)
  dueDate DateTime?
  notes   String?       @db.Text

  sentAt DateTime?
  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  @@index([projectId])
}

// Outbound cadence: an ordered list of templated emails sent automatically
// to enrolled Contacts, spaced by each step's delayDays. See
// src/lib/sequences.ts and scripts/process-sequences.ts (the cron
// processor) for how enrollments actually advance.
model Sequence {
  id        String   @id @default(cuid())
  name      String
  // Gates new enrollments only — flipping this off never touches
  // already-active enrollments; use SequenceEnrollment.status to stop those.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps       SequenceStep[]
  enrollments SequenceEnrollment[]
}

model SequenceStep {
  id        String @id @default(cuid())
  subject   String
  body      String @db.Text
  // Days after the previous step was sent (or after enrollment, for the
  // first step) before this step becomes due.
  delayDays Int    @default(0)
  sortOrder Int    @default(0)

  sequence   Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  sequenceId String

  // Enrollments currently queued on this step. onDelete: SetNull rather
  // than Cascade — editing a live sequence's steps shouldn't silently
  // delete anyone's enrollment; the processor treats a null currentStepId
  // on an ACTIVE enrollment as FAILED instead (see process-sequences.ts).
  enrollments SequenceEnrollment[]

  @@index([sequenceId])
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  STOPPED_REPLY
  STOPPED_MANUAL
  FAILED
}

model SequenceEnrollment {
  id             String           @id @default(cuid())
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime         @default(now())
  nextStepDueAt  DateTime
  lastStepSentAt DateTime?
  lastError      String?          @db.Text

  sequence   Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  sequenceId String

  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String

  // Whose connected mailbox sends each step — needs an EmailAccount at
  // processing time (see scripts/process-sequences.ts).
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  currentStep   SequenceStep? @relation(fields: [currentStepId], references: [id], onDelete: SetNull)
  currentStepId String?

  @@unique([sequenceId, contactId])
  @@index([contactId])
  @@index([status, nextStepDueAt])
}

// Single shared outbound mailbox for bulk newsletter sends — unlike
// EmailAccount (one row per user's own personal inbox, meant for 1:1 sales
// mail), this is one org-wide sending identity, same singleton-row shape as
// WhatsAppAccount. Deliberately separate from EmailAccount rather than
// reusing one admin's connected mailbox: mixing marketing-volume sends onto
// a personal inbox risks that mailbox's own deliverability/reputation, and
// a newsletter has no reason to need IMAP (nothing reads a reply back
// through this).
model NewsletterSender {
  id        String @id @default("singleton")
  fromName  String
  fromEmail String

  smtpHost          String
  smtpPort          Int
  smtpSecure        Boolean
  username          String
  // AES-256-GCM ("iv:authTag:ciphertext", base64) via src/lib/email-crypto.ts
  // — the same helper EmailAccount and WhatsAppAccount already use.
  encryptedPassword String  @db.Text

  updatedAt DateTime @updatedAt
}

enum NewsletterStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
}

// A single broadcast email + one send moment to a whole audience — distinct
// from Sequence, which is a per-contact drip primitive (one independently-
// scheduled SequenceEnrollment row per contact). Recipients are snapshotted
// into NewsletterRecipient rows once (at schedule time, not send time) so
// the audience size is known upfront and a send can pause/resume safely
// across cron ticks without re-resolving list membership mid-send.
model Newsletter {
  id       String           @id @default(cuid())
  subject  String
  // HTML straight from the WYSIWYG editor (src/components/newsletters/
  // newsletter-editor.tsx) — no Markdown round-trip. Image tags reference
  // NewsletterImage by a relative /api/newsletter-images/<id> path;
  // absolutizeImageUrls (src/lib/newsletter-render.ts) rewrites that to a
  // full URL at send time, since a relative path means nothing inside an
  // email client.
  bodyHtml String           @db.Text
  status   NewsletterStatus @default(DRAFT)

  // Set when scheduled (including "send now", which schedules for the
  // current moment) — the cron script's due-check. Left null while DRAFT.
  scheduledAt DateTime?
  // Set once every recipient has been attempted (sent or failed) — not the
  // same instant as scheduledAt, since actually working through a large
  // audience takes multiple cron ticks.
  sentAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Nullable + SetNull rather than a required cascade: deleting the list
  // later shouldn't erase a newsletter's own send history, since
  // NewsletterRecipient already captured who was actually sent to.
  list   ContactList? @relation(fields: [listId], references: [id], onDelete: SetNull)
  listId String?

  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  recipients NewsletterRecipient[]
  images     NewsletterImage[]

  @@index([status, scheduledAt])
  @@index([listId])
}

enum NewsletterRecipientStatus {
  PENDING
  SENT
  FAILED
}

// One row per contact a Newsletter was (or will be) sent to — the durable,
// resumable send queue the cron script works through, and the source of
// each recipient's own one-click unsubscribeToken (so a contact stays
// identifiable from the link alone, without a login).
model NewsletterRecipient {
  id     String                    @id @default(cuid())
  status NewsletterRecipientStatus @default(PENDING)
  sentAt DateTime?
  error  String?                   @db.Text

  unsubscribeToken String @unique @default(cuid())

  newsletter   Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  newsletterId String

  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String

  @@unique([newsletterId, contactId])
  @@index([newsletterId, status])
}

enum WhatsAppBroadcastStatus {
  SENDING
  SENT
}

// A single WhatsApp marketing send to a whole list's opted-in contacts —
// the WhatsApp equivalent of Newsletter, using the same "materialize
// recipients once, cron works through them" architecture for the same
// reason (a large audience can't be sent in one request, and this makes a
// partial run resumable). Always sent immediately, unlike Newsletter,
// which can be scheduled for later — see src/lib/whatsapp-broadcast.ts.
// Requires a Meta-approved Marketing template (see the README's WhatsApp
// section) since Contact.whatsappMarketingOptIn consent alone doesn't put
// a contact inside the 24h session-message window.
model WhatsAppBroadcast {
  id       String                  @id @default(cuid())
  // {{1}} of the approved template — see NEW_UPDATE_TEMPLATE_NAME in
  // src/lib/whatsapp-broadcast.ts.
  headline String
  // {{2}} of the same template.
  link     String
  status   WhatsAppBroadcastStatus @default(SENDING)

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  // Nullable + SetNull rather than a required cascade — same reasoning as
  // Newsletter.list: deleting the list later shouldn't erase send history.
  list   ContactList? @relation(fields: [listId], references: [id], onDelete: SetNull)
  listId String?

  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  recipients WhatsAppBroadcastRecipient[]

  @@index([status])
  @@index([listId])
}

enum WhatsAppBroadcastRecipientStatus {
  PENDING
  SENT
  FAILED
}

// One row per contact a WhatsAppBroadcast was (or will be) sent to — the
// durable, resumable send queue the cron script works through, same role
// NewsletterRecipient plays for Newsletter.
model WhatsAppBroadcastRecipient {
  id     String                           @id @default(cuid())
  status WhatsAppBroadcastRecipientStatus @default(PENDING)
  sentAt DateTime?
  error  String?                          @db.Text

  broadcast   WhatsAppBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  broadcastId String

  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String

  @@unique([broadcastId, contactId])
  @@index([broadcastId, status])
}

// An image inserted into a newsletter's body via the WYSIWYG editor.
// Base64-in-DB rather than a filesystem path, same reasoning as
// Contact.photoUrl and Attachment: this host's cPanel deploy has no
// filesystem an upload could reliably persist across a redeploy/restart.
// Unlike Attachment (tied to one Activity/Task), there's no required link
// back to a Newsletter — an image is uploaded and inserted into the editor
// before the newsletter it belongs to has necessarily been saved yet, so
// the FK is best-effort only, set once the newsletter it was inserted into
// is actually saved. Served publicly (see /api/newsletter-images/[id],
// unlike /api/attachments/[id]) since an email recipient has no session.
model NewsletterImage {
  id        String   @id @default(cuid())
  mimeType  String
  data      String   @db.LongText
  createdAt DateTime @default(now())

  newsletter   Newsletter? @relation(fields: [newsletterId], references: [id], onDelete: SetNull)
  newsletterId String?

  @@index([newsletterId])
}

// ---------------------------------------------------------------------------
// Referral program — see src/lib/referrals.ts for the flow these back.
// A PARTNER (Role) shares /r/<referralCode>; each hit is a ReferralClick and
// a 302 to Settings.referralLandingUrl with ?ref=<code>. The lead-capture
// widget on that page passes the code back with the submission, which sets
// Deal.referredById. When such a deal is won, a ReferralCommission is
// created (PENDING); an admin approves it (APPROVED — now part of the
// partner's withdrawable balance), the partner bundles approved commissions
// into a ReferralWithdrawal request, and an admin marks that PAID once the
// money's actually gone out (which marks the linked commissions PAID too).
// ---------------------------------------------------------------------------

// One row per visit through a partner's link — the "traffic" half of the
// partner portal's stats. ipHash is a one-way hash (never the raw address)
// so "unique visitors" can be approximated without storing PII.
model ReferralClick {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  ipHash    String?
  userAgent String?
  referer   String?

  partner   User   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId String

  @@index([partnerId, createdAt])
}

enum ReferralCommissionStatus {
  PENDING
  APPROVED
  PAID
  VOID
}

// Money a partner is owed for one referred deal that was won. rate/
// dealValue/amount are snapshotted at the moment of winning — a later
// change to the default rate or the partner's override doesn't retroactively
// re-price commissions already earned. VOID is the admin's "this one doesn't
// count" (deal re-opened, refunded, self-referral...) — a PENDING commission
// is also voided automatically if its deal leaves the won stage before an
// admin ever approved it.
//
// deal is nullable + SetNull (with dealTitle snapshotted) rather than a
// required cascade, same reasoning as Newsletter.list: deleting a deal
// later shouldn't erase the money trail, especially once it's been paid.
model ReferralCommission {
  id         String                   @id @default(cuid())
  status     ReferralCommissionStatus @default(PENDING)
  rate       Decimal                  @db.Decimal(5, 2)
  dealValue  Decimal                  @db.Decimal(12, 2)
  amount     Decimal                  @db.Decimal(12, 2)
  dealTitle  String
  createdAt  DateTime                 @default(now())
  approvedAt DateTime?
  paidAt     DateTime?

  partner   User   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId String

  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealId String? @unique

  // Set once this commission is bundled into a withdrawal request; cleared
  // again if that request is rejected, putting the money back in the
  // partner's available balance.
  withdrawal   ReferralWithdrawal? @relation(fields: [withdrawalId], references: [id], onDelete: SetNull)
  withdrawalId String?

  @@index([partnerId, status])
  @@index([withdrawalId])
}

enum ReferralWithdrawalStatus {
  REQUESTED
  PAID
  REJECTED
}

// A partner's request to be paid out their APPROVED balance. amount is the
// sum of the linked commissions at request time. paymentDetails is
// free-text from the partner (bank account, e-wallet, etc.) since this app
// doesn't move money itself — an admin pays out by hand and then marks
// this PAID, optionally noting the reference.
model ReferralWithdrawal {
  id             String                   @id @default(cuid())
  status         ReferralWithdrawalStatus @default(REQUESTED)
  amount         Decimal                  @db.Decimal(12, 2)
  paymentDetails String                   @db.Text
  adminNote      String?                  @db.Text
  requestedAt    DateTime                 @default(now())
  resolvedAt     DateTime?

  partner   User   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId String

  commissions ReferralCommission[]

  @@index([partnerId, status])
}

// Review state of a partner's *draft* directory listing (see
// PartnerListing) — deliberately separate from whether anything is live,
// which is "publishedSnapshot is set". DRAFT covers both never-submitted and
// "edited since it was last approved"; REJECTED keeps the admin's note so
// the partner can fix and resubmit.
enum PartnerListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

// A PARTNER user's public profile in the directory (/directory/<slug>).
// The editable fields are the partner's working draft; publishedSnapshot is
// a JSON copy of the public fields as they were the last time an admin
// approved them, and is the only thing the public directory ever renders —
// so a partner can edit freely while their last-approved version stays up,
// and nothing unreviewed is ever visible. The partner's own User.email /
// User.phone are never part of the snapshot: visitors reach a partner only
// through the lead form (DirectoryLead), never directly.
model PartnerListing {
  id     String               @id @default(cuid())
  slug   String               @unique
  status PartnerListingStatus @default(DRAFT)

  companyName String
  tagline     String?
  description String?   @db.Text
  services    Json // string[] — free-text service/product names
  industry    Industry?
  website     String?
  location    String? // short display text, e.g. "Kuala Lumpur, Malaysia"
  address     String?   @db.Text // fuller street address, for the map embed and schema.org markup
  operatingHours Json? // OperatingHours (src/lib/directory.ts) — one entry per day of week, each either a single open/close time range or null (closed)
  logoUrl     String?   @db.LongText // data: URL, same as Contact.photoUrl

  reviewNote        String?   @db.Text
  submittedAt       DateTime?
  reviewedAt        DateTime?
  publishedAt       DateTime?
  publishedSnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner   User   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId String @unique

  leads DirectoryLead[]

  @@index([status])
}

// Declared in workflow order so the partner-facing status picker can list
// them as-is. NEW → PICKED_UP is the partner claiming it; the rest is up to
// them to keep current. WON/LOST close it.
enum DirectoryLeadStatus {
  NEW
  PICKED_UP
  CONTACTED
  QUOTED
  WON
  LOST
}

// A visitor's inquiry sent through a listing's contact form. Not a Deal:
// this lead belongs to the partner to work (status/value/replies are theirs
// to set from the partner portal), whereas a Deal is Gotka's own pipeline
// and a partner can't see or change its stages by design. Admins get a
// read-only overview from Settings → Directory.
model DirectoryLead {
  id     String              @id @default(cuid())
  status DirectoryLeadStatus @default(NEW)

  name    String
  email   String
  phone   String?
  company String?
  message String  @db.Text
  // Which language the visitor had the directory in when they wrote this —
  // shown to the partner so they can reply in kind.
  locale  String  @default("en")

  // Set by the partner: what this lead is (or ended up being) worth to them.
  value Decimal? @db.Decimal(12, 2)
  notes String?  @db.Text

  pickedUpAt     DateTime?
  firstRepliedAt DateTime?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  listing   PartnerListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  replies DirectoryLeadReply[]

  @@index([listingId, status])
  @@index([createdAt])
}

// One message from the partner to the visitor, written in the partner
// portal and delivered by email from the system sender (never from the
// partner's own address — see src/lib/directory-notify.ts). sentAt/sendError
// record whether that email actually went out; the reply row is kept either
// way so the thread the partner sees is complete.
model DirectoryLeadReply {
  id        String    @id @default(cuid())
  body      String    @db.Text
  createdAt DateTime  @default(now())
  sentAt    DateTime?
  sendError String?   @db.Text

  lead   DirectoryLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId String

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  @@index([leadId])
}
