// Prisma schema for the GoTech CRM
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum TaskType {
  CALL
  EMAIL
  MEETING
  FOLLOW_UP
  MILESTONE
  OTHER
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  STAGE_CHANGE
  TASK_COMPLETED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  title        String?
  createdAt    DateTime @default(now())

  emailAccount        EmailAccount?
  deals               Deal[]
  timeEntries         TimeEntry[]
  sequenceEnrollments SequenceEnrollment[]
  assignedTasks       Task[]         @relation("TaskAssignee")
  followingTasks      TaskFollower[]
}

// One connected IMAP/SMTP mailbox per user (their own inbox, not a shared
// team one) — see src/lib/email-sync.ts. Credentials are never stored in
// plaintext.
model EmailAccount {
  id                String  @id @default(cuid())
  email             String
  imapHost          String
  imapPort          Int     @default(993)
  imapSecure        Boolean @default(true)
  smtpHost          String
  smtpPort          Int     @default(465)
  smtpSecure        Boolean @default(true)
  username          String
  // AES-256-GCM ciphertext ("iv:authTag:ciphertext", base64) — the key is
  // derived from SESSION_SECRET via HKDF (see src/lib/email-crypto.ts), so
  // connecting a mailbox needs no extra required env var to deploy.
  encryptedPassword String  @db.Text

  // JSON: { [folderPath]: highestUidSeen } — an IMAP UID only ever increases
  // within a folder, so "highest UID synced" is a cheap, correct incremental
  // checkpoint per folder (INBOX and the account's Sent folder are tracked
  // separately, since their UID sequences are independent).
  syncState     String    @default("{}") @db.Text
  lastSyncedAt  DateTime?
  lastSyncError String?   @db.Text
  // Rate-limits scripts/send-task-digests.ts to roughly once a day
  // regardless of how often its cron job actually runs.
  lastDigestSentAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique
}

// Single-row table for CRM-wide settings (currency, booking-link
// availability). Always read/written at id "singleton" — see src/lib/settings.ts.
model Settings {
  id       String @id @default("singleton")
  currency String @default("USD")

  // Booking link (see src/lib/booking.ts). A fixed UTC offset rather than an
  // IANA timezone — simpler and DST-free, and the org this ships for doesn't
  // observe DST — labeled clearly in the Settings UI rather than pretending
  // to be a full tz database.
  bookingUtcOffsetMinutes Int    @default(480) // UTC+8
  bookingSlotMinutes      Int    @default(30)
  // JSON-encoded WeeklyHours (see src/lib/booking.ts) — 7 entries,
  // index 0 = Sunday..6 = Saturday, each { enabled, start: "HH:mm", end: "HH:mm" }.
  bookingWeeklyHours      String @default("[{\"enabled\":false,\"start\":\"09:00\",\"end\":\"17:00\"},{\"enabled\":true,\"start\":\"09:00\",\"end\":\"17:00\"},{\"enabled\":true,\"start\":\"09:00\",\"end\":\"17:00\"},{\"enabled\":true,\"start\":\"09:00\",\"end\":\"17:00\"},{\"enabled\":true,\"start\":\"09:00\",\"end\":\"17:00\"},{\"enabled\":true,\"start\":\"09:00\",\"end\":\"17:00\"},{\"enabled\":false,\"start\":\"09:00\",\"end\":\"17:00\"}]") @db.Text
}

model Company {
  id        String   @id @default(cuid())
  name      String
  domain    String?
  industry  String?
  phone     String?
  address   String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts   Contact[]
  deals      Deal[]
  tasks      Task[]
  activities Activity[]

  @@index([name])
}

model Contact {
  id        String   @id @default(cuid())
  firstName String
  lastName  String?
  email     String?
  phone     String?
  title     String?
  notes     String?  @db.Text
  // Stored as a data: URL (base64), not a file path — this app's cPanel
  // deploy copies public/ on every deploy and the git checkout can double
  // as the live app directory, both of which make filesystem-persisted
  // uploads fragile. Keeping the photo in the same row as everything else
  // sidesteps that entirely. @db.LongText because a base64-encoded image
  // comfortably exceeds the default column's size.
  photoUrl  String?  @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Last time email sync saw an inbound message from this contact — not
  // shown anywhere yet, but it's what lets an outbound sequence
  // (src/lib/sequences.ts) auto-stop the moment a contact replies, by
  // comparing this against the enrollment's enrolledAt rather than
  // re-scanning Activity rows.
  lastInboundEmailAt DateTime?

  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId String?

  deals               Deal[]
  tasks               Task[]
  activities          Activity[]
  bookings            Booking[]
  clientUser          ClientUser?
  sequenceEnrollments SequenceEnrollment[]

  @@index([companyId])
  @@index([lastName, firstName])
}

// A client-side portal login, entirely separate from the internal User
// model/session (see src/lib/portal/session.ts — a distinct signed cookie,
// distinct signing key). Scoped through its Contact to that Contact's
// Company, never directly to a companyId, so portal access can never
// outlive or outgrow the underlying CRM relationship. passwordHash is null
// until the invite (inviteToken) is accepted.
model ClientUser {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String?   @db.Text
  inviteToken          String?   @unique
  inviteTokenExpiresAt DateTime?
  createdAt            DateTime  @default(now())

  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String  @unique
}

// A confirmed slot from the public booking page (see src/app/book). The
// unique startAt is the actual double-booking guard — two people can't
// reserve the same fixed-duration slot even under a concurrent submit race
// (the DB rejects the second insert; see submitBooking's error handling).
model Booking {
  id        String   @id @default(cuid())
  startAt   DateTime
  endAt     DateTime
  name      String
  email     String
  phone     String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String

  @@unique([startAt])
  @@index([contactId])
}

// A deal type's own ordered stage list (Zoho-style "Blueprint"), so a
// new-build project, a maintenance retainer, and a referral don't have to
// share one kanban. Every install gets exactly one pipeline seeded with
// today's original 6 stages (see the add_pipelines migration) — additional
// pipelines are opt-in, created from Settings.
model Pipeline {
  id        String   @id @default(cuid())
  name      String
  isDefault Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  stages PipelineStage[]
  deals  Deal[]

  @@index([sortOrder])
}

// isWon/isLost replace the old fixed WON/LOST enum values — every stage-gate,
// rotting, and project-handoff check that used to compare against those
// strings now checks these flags instead, so each pipeline can name its own
// terminal stages ("Closed Won", "Signed", ...) while that logic stays
// pipeline-agnostic. Exactly one stage in a pipeline should carry each flag,
// enforced by the pipeline editor rather than the schema.
model PipelineStage {
  id        String  @id @default(cuid())
  name      String
  sortOrder Int
  isWon     Boolean @default(false)
  isLost    Boolean @default(false)

  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  pipelineId String

  deals Deal[]

  @@index([pipelineId])
}

model Deal {
  id                String    @id @default(cuid())
  title             String
  value             Decimal   @default(0) @db.Decimal(12, 2)
  expectedCloseDate DateTime?
  notes             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Set/cleared automatically whenever the deal moves into/out of a
  // pipeline's isWon stage (see app/actions/deals.ts) — not just "is this
  // deal currently won" (pipelineStage.isWon already answers that) but
  // *when* it most recently became won, for period-filtering the
  // leaderboard (see src/app/(app)/leaderboard).
  wonAt DateTime?

  pipeline   Pipeline @relation(fields: [pipelineId], references: [id])
  pipelineId String

  pipelineStage   PipelineStage @relation(fields: [pipelineStageId], references: [id])
  pipelineStageId String

  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId String?

  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId String?

  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId String?

  tasks      Task[]
  activities Activity[]
  quotes     Quote[]
  project    Project?

  @@index([companyId])
  @@index([contactId])
  @@index([pipelineId])
  @@index([pipelineStageId])
  @@index([ownerId])
}

// The delivery-side counterpart to a won Deal — spun up automatically (see
// ensureProjectForWonDeal) instead of dumping delivery work into the same
// flat task list as sales to-dos. One deal converts into at most one
// project, hence the unique dealId; the project's own status then tracks
// delivery progress independently of the deal's (now-frozen) sales stage.
model Project {
  id        String        @id @default(cuid())
  name      String
  status    ProjectStatus @default(NOT_STARTED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId String @unique

  tasks      Task[]
  activities Activity[]
  invoices   Invoice[]
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  type        TaskType  @default(OTHER)
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String?

  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String?

  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId String?

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?

  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId String?

  timeEntries TimeEntry[]
  followers   TaskFollower[]

  @@index([contactId])
  @@index([companyId])
  @@index([dealId])
  @@index([projectId])
  @@index([dueDate])
  @@index([assigneeId])
}

// Who gets visibility on a Task without being the one responsible for it
// (that's `Task.assignee`) — a plain many-to-many via an explicit join
// model, matching this schema's convention of never using Prisma's implicit
// m:n tables.
model TaskFollower {
  id String @id @default(cuid())

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([taskId, userId])
  @@index([userId])
}

// A logged block of work on a Task. Rollup totals on Deal/Project/Contact/
// Company pages aggregate through task.{dealId,projectId,contactId,companyId}
// rather than duplicating a parent link here.
model TimeEntry {
  id        String   @id @default(cuid())
  minutes   Int
  note      String?  @db.Text
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([taskId])
  @@index([userId])
}

model Activity {
  id        String       @id @default(cuid())
  type      ActivityType
  content   String       @db.Text
  createdAt DateTime     @default(now())

  // Set only for activities auto-logged by email sync — a stable dedup key
  // ("<accountId>:<folder>:<uid>:<contactId>", one row per matched contact
  // since a single email can match several) so a re-run over the same IMAP
  // UID range can never double-log the same message. Null for every
  // manually-created activity.
  externalId String? @unique

  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String?

  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String?

  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId String?

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?

  @@index([contactId])
  @@index([companyId])
  @@index([dealId])
  @@index([projectId])
  @@index([createdAt])
}

// Reusable catalog of things GoTech sells, so quotes are built from
// consistent line items instead of free-typed descriptions/prices every time.
model ServicePackage {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  unitPrice   Decimal  @default(0) @db.Decimal(12, 2)
  unit        String? // e.g. "project", "hour", "month" — free text, shown after the price
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quoteItems QuoteItem[]
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
}

model Quote {
  id     String      @id @default(cuid())
  title  String
  status QuoteStatus @default(DRAFT)
  notes  String?     @db.Text // terms shown to the client under the line items

  sentAt        DateTime?
  firstViewedAt DateTime?
  lastViewedAt  DateTime?
  viewCount     Int       @default(0)
  respondedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId String

  items QuoteItem[]

  @@index([dealId])
}

model QuoteItem {
  id          String  @id @default(cuid())
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @default(0) @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId String

  servicePackage   ServicePackage? @relation(fields: [servicePackageId], references: [id], onDelete: SetNull)
  servicePackageId String?

  @@index([quoteId])
  @@index([servicePackageId])
}

// Payment-milestone billing for a Project (post-sale — a Quote is the
// pre-sale document). A project typically carries several Invoices over its
// life (deposit, progress billing, final), each walking its own status
// through these milestones rather than a generic sent/paid pair.
enum InvoiceStatus {
  DRAFT
  DEPOSIT_SENT
  PROGRESS_BILLED
  PAID_IN_FULL
}

model Invoice {
  id      String        @id @default(cuid())
  title   String
  amount  Decimal       @db.Decimal(12, 2)
  status  InvoiceStatus @default(DRAFT)
  dueDate DateTime?
  notes   String?       @db.Text

  sentAt DateTime?
  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  @@index([projectId])
}

// Outbound cadence: an ordered list of templated emails sent automatically
// to enrolled Contacts, spaced by each step's delayDays. See
// src/lib/sequences.ts and scripts/process-sequences.ts (the cron
// processor) for how enrollments actually advance.
model Sequence {
  id        String   @id @default(cuid())
  name      String
  // Gates new enrollments only — flipping this off never touches
  // already-active enrollments; use SequenceEnrollment.status to stop those.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps       SequenceStep[]
  enrollments SequenceEnrollment[]
}

model SequenceStep {
  id        String @id @default(cuid())
  subject   String
  body      String @db.Text
  // Days after the previous step was sent (or after enrollment, for the
  // first step) before this step becomes due.
  delayDays Int    @default(0)
  sortOrder Int    @default(0)

  sequence   Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  sequenceId String

  // Enrollments currently queued on this step. onDelete: SetNull rather
  // than Cascade — editing a live sequence's steps shouldn't silently
  // delete anyone's enrollment; the processor treats a null currentStepId
  // on an ACTIVE enrollment as FAILED instead (see process-sequences.ts).
  enrollments SequenceEnrollment[]

  @@index([sequenceId])
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  STOPPED_REPLY
  STOPPED_MANUAL
  FAILED
}

model SequenceEnrollment {
  id             String           @id @default(cuid())
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime         @default(now())
  nextStepDueAt  DateTime
  lastStepSentAt DateTime?
  lastError      String?          @db.Text

  sequence   Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  sequenceId String

  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String

  // Whose connected mailbox sends each step — needs an EmailAccount at
  // processing time (see scripts/process-sequences.ts).
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  currentStep   SequenceStep? @relation(fields: [currentStepId], references: [id], onDelete: SetNull)
  currentStepId String?

  @@unique([sequenceId, contactId])
  @@index([contactId])
  @@index([status, nextStepDueAt])
}
