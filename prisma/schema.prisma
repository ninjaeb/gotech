// Prisma schema for the GoTech CRM
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum DealStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum TaskType {
  CALL
  EMAIL
  MEETING
  FOLLOW_UP
  OTHER
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  STAGE_CHANGE
  TASK_COMPLETED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  title        String?
  createdAt    DateTime @default(now())
}

// Single-row table for CRM-wide settings (currently just currency).
// Always read/written at id "singleton" — see src/lib/settings.ts.
model Settings {
  id       String @id @default("singleton")
  currency String @default("USD")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  domain    String?
  industry  String?
  phone     String?
  address   String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts   Contact[]
  deals      Deal[]
  tasks      Task[]
  activities Activity[]

  @@index([name])
}

model Contact {
  id        String   @id @default(cuid())
  firstName String
  lastName  String?
  email     String?
  phone     String?
  title     String?
  notes     String?  @db.Text
  // Stored as a data: URL (base64), not a file path — this app's cPanel
  // deploy copies public/ on every deploy and the git checkout can double
  // as the live app directory, both of which make filesystem-persisted
  // uploads fragile. Keeping the photo in the same row as everything else
  // sidesteps that entirely. @db.LongText because a base64-encoded image
  // comfortably exceeds the default column's size.
  photoUrl  String?  @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId String?

  deals      Deal[]
  tasks      Task[]
  activities Activity[]

  @@index([companyId])
  @@index([lastName, firstName])
}

model Deal {
  id                String    @id @default(cuid())
  title             String
  value             Decimal   @default(0) @db.Decimal(12, 2)
  stage             DealStage @default(LEAD)
  expectedCloseDate DateTime?
  notes             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId String?

  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId String?

  tasks      Task[]
  activities Activity[]
  quotes     Quote[]

  @@index([companyId])
  @@index([contactId])
  @@index([stage])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  type        TaskType  @default(OTHER)
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String?

  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String?

  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId String?

  @@index([contactId])
  @@index([companyId])
  @@index([dealId])
  @@index([dueDate])
}

model Activity {
  id        String       @id @default(cuid())
  type      ActivityType
  content   String       @db.Text
  createdAt DateTime     @default(now())

  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String?

  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String?

  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId String?

  @@index([contactId])
  @@index([companyId])
  @@index([dealId])
  @@index([createdAt])
}

// Reusable catalog of things GoTech sells, so quotes are built from
// consistent line items instead of free-typed descriptions/prices every time.
model ServicePackage {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  unitPrice   Decimal  @default(0) @db.Decimal(12, 2)
  unit        String? // e.g. "project", "hour", "month" — free text, shown after the price
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quoteItems QuoteItem[]
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
}

model Quote {
  id     String      @id @default(cuid())
  title  String
  status QuoteStatus @default(DRAFT)
  notes  String?     @db.Text // terms shown to the client under the line items

  sentAt        DateTime?
  firstViewedAt DateTime?
  lastViewedAt  DateTime?
  viewCount     Int       @default(0)
  respondedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId String

  items QuoteItem[]

  @@index([dealId])
}

model QuoteItem {
  id          String  @id @default(cuid())
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @default(0) @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId String

  servicePackage   ServicePackage? @relation(fields: [servicePackageId], references: [id], onDelete: SetNull)
  servicePackageId String?

  @@index([quoteId])
  @@index([servicePackageId])
}
